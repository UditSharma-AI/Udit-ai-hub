[{"type":"mcq","q":"Who introduced command-query separation?","opts":["Greg Young","Bertrand Meyer","Linus Torvalds","Robert Martin"],"a":[1],"why":"Meyer, with Eiffel; Young popularised CQRS.","topic":"CQRS"},{"type":"multi","q":"Which HTTP methods are commands? (select all)","opts":["GET","POST","PUT","DELETE"],"a":[1,2,3],"why":"State-changing operations.","topic":"CQRS"},{"type":"mcq","q":"In CQRS, what updates the read store?","opts":["The query handler","A projection from the write side","The client","Nothing"],"a":[1],"why":"Projection with eventual consistency.","topic":"CQRS"},{"type":"mcq","q":"Kafka and Kinesis are examples of…","opts":["Vector stores","Event streams","Embedding models","Web frameworks"],"a":[1],"why":"They separate command and query sides.","topic":"Eventual consistency"},{"type":"tf","q":"With eventual consistency, all users get a new model version at exactly the same moment.","a":false,"why":"They converge over minutes.","topic":"Eventual consistency"},{"type":"mcq","q":"Which is part of the ingestion (write) pipeline in RAG?","opts":["Answer generation","Chunking","Prompt construction","Query embedding"],"a":[1],"why":"Documents → extraction → chunking → embedding → indexing.","topic":"RAG"},{"type":"mcq","q":"Which embeddings lack contextual awareness?","opts":["BERT","Sentence-BERT","GloVe","DPR"],"a":[2],"why":"GloVe is word-level, non-contextual.","topic":"RAG components"},{"type":"mcq","q":"ChromaDB stores text and metadata in…","opts":["MySQL","SQLite","Redis","CSV files"],"a":[1],"why":"SQLite + HNSW index.","topic":"RAG components"},{"type":"mcq","q":"Which is a limitation of a monolith?","opts":["Shared memory","Only the whole app can be scaled","Easy end-to-end testing","Single deployment file"],"a":[1],"why":"Scalability limitation.","topic":"Monolith"},{"type":"mcq","q":"In the monolithic ML pattern, a model update typically requires…","opts":["No deployment","Redeploying the whole application","Only a DNS change","A new database"],"a":[1],"why":"One deployment unit.","topic":"Monolithic ML"},{"type":"mcq","q":"'Gather together the things that change for the same reasons' is…","opts":["Open-closed principle","Single-responsibility principle","CQS","DRY"],"a":[1],"why":"Robert C. Martin's SRP.","topic":"Microservices"},{"type":"mcq","q":"In the microservices ML demo, which service only performs inference?","opts":["Gateway","Model service","Logging service","Database"],"a":[1],"why":"Single responsibility.","topic":"Microservices ML"}]